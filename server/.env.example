# RouteLLM API anahtarı (apps.abacus.ai → LLM APIs). Boş bırakılırsa DEMO modunda çalışır.
ABACUS_API_KEY=

# Sohbet modeli: route-llm otomatik yönlendirir
CHAT_MODEL=route-llm


# ---- Ses (TTS) ----
# Sabit bir model + sabit bir ses kimliği şart; yönlendirmeli model (route-llm, router) reddedilir.
# `npm run voices` sesleri gerçek isteklerle sınar (metne sadakat + perde kararlılığı) ve data/voices.json'a yazar.
# Ölçüm: Gemini TTS aynı sesi her istekte farklı perdede üretiyor (125–197 Hz); gpt-audio sabit kalıyor.
# Ayarlar → Ses'ten seçilen ses bunu ezer (tüm cihazlarda ortak); burası yalnızca varsayılan.
TTS_MODEL=gpt-audio-1.5
TTS_VOICE=onyx
# İstemci oynatma hızı (0.9–1.3); Ayarlar'daki kaydırıcının varsayılanı
TTS_RATE=1.08
# Yalnızca /audio/speech yöntemi için (RouteLLM'de şu an yok)
TTS_SPEED=1.1
# Üslup talimatı İNGİLİZCE olmalı: Türkçe talimatta gpt-audio metne "Tabii, işte okuyorum" diye önsöz ekliyor (ölçüldü).
# TTS_STYLE=Tone: calm, confident and warm, like a trusted AI butler. Natural, fluent and lively pace without unnecessary pauses

# ---- Ses tanıma (STT): /audio/transcriptions yok; ses girdili sohbet modeli kullanılır ----
STT_MODEL=gemini-2.5-flash

# ---- Görseller ----
# Sembolik konular için temsili görsel (gerçek kişi/olay asla). Boş bırakılırsa üretilmez.
IMAGE_MODEL=flux2
# Görüntü modeli. Fotoğraf sorularında boş = CHAT_MODEL (route-llm görsel girdiyi destekliyor); kamera aracında (kameraya_bak) boş = gemini-3.8-flash.
VISION_MODEL=

# Jarvis'in sana nasıl hitap edeceği
USER_NAME=Halil
USER_ABOUT=Türkiye'de yaşıyor, yazılımcı ve içerik üreticisi.

# Video modunda stok fotoğraf için (ikisinden biri yeter, ikisi de ücretsiz)
PEXELS_API_KEY=
UNSPLASH_ACCESS_KEY=

# Tünel/deploy kullanırken mutlaka doldur: arayüzü ?token=... ile bir kez açman yeterli
ACCESS_TOKEN=

PORT=8787
# MOCK=1

# Sabah panosu: hava durumu konumu (Open-Meteo, anahtar gerekmez)
WEATHER_CITY=İstanbul
WEATHER_LAT=41.01
WEATHER_LON=28.98

# İsteğe bağlı: ElevenLabs sesi (beyin yine RouteLLM). Anahtar: elevenlabs.io → Profile → API Keys
ELEVENLABS_API_KEY=
# eleven_v4_turbo (hızlı, duygu etiketleri) · eleven_v4 (en doğal anlatım) · eleven_multilingual_v2
ELEVENLABS_MODEL=eleven_v4_turbo

# İsteğe bağlı: YouTube araması ("… videosunu aç"). Ücretsiz: console.cloud.google.com → YouTube Data API v3 → API anahtarı
YOUTUBE_API_KEY=
# İsteğe bağlı: maç özeti için ek resmi kanallar (Ad=KanalKimliği, virgülle). beIN SPORTS Türkiye varsayılan.
YOUTUBE_CHANNELS=
# Kendi YouTube kanalınız ("son videomu aç" → son Shorts) ve favori kanallar
YOUTUBE_OWN_CHANNEL=
# Kanalınıza verdiğiniz adlar (virgülle) ve görünen adı
YOUTUBE_OWN_ALIASES=
YOUTUBE_OWN_NAME=
YOUTUBE_FAVORITES=

# Kamera cihazı (Jarvis'in gözü). ACCESS_TOKEN boşsa kamera özelliği tamamen kapalıdır.
# Görüntü modeli: VISION_MODEL (boşsa kamerada gemini-3.8-flash; fotoğraf sorularında CHAT_MODEL)
# WebRTC için isteğe bağlı TURN (yoksa yalnızca STUN; bağlantı kurulamazsa aralıklı kare moduna düşer)
TURN_URL=
TURN_USERNAME=
TURN_CREDENTIAL=

# İsteğe bağlı: Akıllı ev için Home Assistant (boşsa simülasyon). Uzun ömürlü erişim anahtarı: HA → Profil → Güvenlik
HOME_ASSISTANT_URL=
HOME_ASSISTANT_TOKEN=
# Jarvis cihazı = HA varlığı (kahve makineleri akıllı prizle)
HA_ENTITIES=salon_isik=light.salon,calisma_isik=light.calisma_odasi,turk_kahve=switch.turk_kahve_priz,filtre_kahve=switch.filtre_kahve_priz
