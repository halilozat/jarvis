# ---- Beyin (yapay zekâ servisi) ----
# En kolayı: uygulamada Ayarlar → Beyin (ilk açılışta kendiliğinden gelir). Oradan kaydedilen ayar buradakini ezer.
# Burada vermek istersen: AI_PROVIDER = gemini | groq | openai | anthropic | openrouter | abacus | ozel
# Gemini ve Groq ücretsiz (kart istemez). Hiçbiri yoksa DEMO modu: hazır cevaplar + ücretsiz gerçek veriler.
AI_PROVIDER=
AI_API_KEY=
# Yalnızca ozel (OpenAI uyumlu) sağlayıcıda: ör. https://api.deepseek.com/v1
AI_BASE_URL=

# Abacus.AI RouteLLM (eski yöntem, hâlâ geçerli): apps.abacus.ai → LLM APIs
ABACUS_API_KEY=

# Sohbet modeli. Boş = sağlayıcının önerdiği (Abacus'ta route-llm otomatik yönlendirir)
CHAT_MODEL=


# ---- Ses (TTS) ----
# Yalnızca Abacus'ta (ses kataloğu). OpenAI'da TTS_VOICE = onyx, nova, … ; Gemini/Groq/Claude'da ses tarayıcıdan ya da ElevenLabs'ten.
# Sabit bir model + sabit bir ses kimliği şart; yönlendirmeli model (route-llm, router) reddedilir.
# `npm run voices` sesleri gerçek isteklerle sınar (metne sadakat + perde kararlılığı) ve data/voices.json'a yazar.
# Ölçüm: Gemini TTS aynı sesi her istekte farklı perdede üretiyor (125–197 Hz); gpt-audio sabit kalıyor.
# Ayarlar → Ses'ten seçilen ses bunu ezer (tüm cihazlarda ortak); burası yalnızca varsayılan.
TTS_MODEL=gpt-audio-1.5
TTS_VOICE=onyx
# İstemci oynatma hızı (0.9–1.3); Ayarlar'daki kaydırıcının varsayılanı
TTS_RATE=1.08
# Yalnızca /audio/speech yöntemi için (RouteLLM'de şu an yok)
TTS_SPEED=1.1
# Üslup talimatı İNGİLİZCE olmalı: Türkçe talimatta gpt-audio metne "Tabii, işte okuyorum" diye önsöz ekliyor (ölçüldü).
# TTS_STYLE=Tone: calm, confident and warm, like a trusted AI butler. Natural, fluent and lively pace without unnecessary pauses

# ---- Ses tanıma (STT): /audio/transcriptions yok; ses girdili sohbet modeli kullanılır ----
STT_MODEL=gemini-2.5-flash

# ---- Görseller ----
# Sembolik konular için temsili görsel (gerçek kişi/olay asla). Boş bırakılırsa üretilmez.
IMAGE_MODEL=flux2
# Görüntü modeli. Fotoğraf sorularında boş = CHAT_MODEL (route-llm görsel girdiyi destekliyor); kamera aracında (kameraya_bak) boş = gemini-3.8-flash.
VISION_MODEL=

# Jarvis'in sana nasıl hitap edeceği
USER_NAME=
USER_ABOUT=Türkiye'de yaşıyor, yazılımcı ve içerik üreticisi.

# Video modunda stok fotoğraf için (ikisinden biri yeter, ikisi de ücretsiz)
PEXELS_API_KEY=
UNSPLASH_ACCESS_KEY=

# Tünel/deploy kullanırken mutlaka doldur: arayüzü ?token=... ile bir kez açman yeterli
ACCESS_TOKEN=

PORT=8787
# MOCK=1

# Sabah panosu: hava durumu konumu (Open-Meteo, anahtar gerekmez)
WEATHER_CITY=İstanbul
WEATHER_LAT=41.01
WEATHER_LON=28.98

# Seslendirmesi olmayan beyinde (Gemini, Groq, Claude) varsayılan ElevenLabs sesi (ses kimliği). Boşsa tarayıcı sesi.
ELEVENLABS_VOICE=
# İsteğe bağlı: ElevenLabs sesi (beyin hangi servis olursa olsun). Anahtar: elevenlabs.io → Profile → API Keys
ELEVENLABS_API_KEY=
# eleven_v4_turbo (hızlı, duygu etiketleri) · eleven_v4 (en doğal anlatım) · eleven_multilingual_v2
ELEVENLABS_MODEL=eleven_v4_turbo

# İsteğe bağlı: YouTube araması ("… videosunu aç"). Ücretsiz: console.cloud.google.com → YouTube Data API v3 → API anahtarı
YOUTUBE_API_KEY=
# İsteğe bağlı: maç özeti için ek resmi kanallar (Ad=KanalKimliği, virgülle). beIN SPORTS Türkiye varsayılan.
YOUTUBE_CHANNELS=
# Kendi YouTube kanalınız ("son videomu aç" → son Shorts) ve favori kanallar
YOUTUBE_OWN_CHANNEL=
# Kanalınıza verdiğiniz adlar (virgülle) ve görünen adı
YOUTUBE_OWN_ALIASES=
YOUTUBE_OWN_NAME=
YOUTUBE_FAVORITES=

# Kamera cihazı (Jarvis'in gözü). ACCESS_TOKEN boşsa kamera özelliği tamamen kapalıdır.
# Görüntü modeli: VISION_MODEL (boşsa kamerada gemini-3.8-flash; fotoğraf sorularında CHAT_MODEL)
# WebRTC için isteğe bağlı TURN (yoksa yalnızca STUN; bağlantı kurulamazsa aralıklı kare moduna düşer)
TURN_URL=
TURN_USERNAME=
TURN_CREDENTIAL=

# İsteğe bağlı: Akıllı ev için Home Assistant (boşsa simülasyon). Uzun ömürlü erişim anahtarı: HA → Profil → Güvenlik
HOME_ASSISTANT_URL=
HOME_ASSISTANT_TOKEN=
# Jarvis cihazı = HA varlığı (kahve makineleri akıllı prizle)
HA_ENTITIES=salon_isik=light.salon,calisma_isik=light.calisma_odasi,turk_kahve=switch.turk_kahve_priz,filtre_kahve=switch.filtre_kahve_priz

# Bekçi: gelen SMS ve e-postaları gelir gelmez denetler, dolandırıcılık şüphesinde sesli uyarır + telefona bildirim.
# Ayrıntılar README → "Bekçi Modülü". Eşikler, ağırlıklar, sessiz saatler: server/config/bekci.json
BEKCI_ENABLED=true
# SMS/iMessage/RCS (yalnızca macOS): Tam Disk Erişimi + iPhone'da Metin Mesajı Yönlendirme gerekir
BEKCI_SMS_ENABLED=true
BEKCI_MAIL_ENABLED=true
# E-posta hesapları (IMAP, salt okunur). Gmail için uygulama şifresi. Örnek:
# IMAP_ACCOUNTS=[{"name":"gmail","host":"imap.gmail.com","port":993,"user":"adiniz@gmail.com","pass":"uygulama-sifresi"}]
IMAP_ACCOUNTS=
# Telefona bildirim (ntfy uygulaması). Topic tahmin edilemeyecek uzunlukta rastgele olmalı (ör. bekci-7f3k9q2xw8m1)
NTFY_URL=https://ntfy.sh
NTFY_TOPIC=
# İsteğe bağlı itibar servisleri (yalnızca URL gönderilir)
GSB_API_KEY=
VT_API_KEY=
URLSCAN_API_KEY=
# İsteğe bağlı: Bekçi'nin metin analizi için ayrı model (boşsa seçili beyin)
BEKCI_MODEL=

# Toplantı Odası: Jarvis ve ikinci yapay zekâ Friday bir soruyu tartışır; canlı toplantıya sesle katılırsınız; tutanak çıkar.
# Ayrıntılar README → "Toplantı Odası". Hitaplar, cümle sınırı, renkler: server/config/meeting.json
MEETING_ENABLED=true
# Seçili beyindeki model adları. Boşsa otomatik: Jarvis ve Friday'e farklı ailelerden hızlı iki model, hakeme ucuz bir model.
# Aynı model kendisiyle tartışınca hızla uzlaşır; farklı iki model önerilir (ör. JARVIS_MODEL=gpt-6-luna, FRIDAY_MODEL=claude-haiku-5-5)
JARVIS_MODEL=
FRIDAY_MODEL=
JUDGE_MODEL=
# Friday'in ElevenLabs ses kimliği (boşsa hesaptaki Türkçe kadın sesi seçilir). Ünlü birinin sesini taklit eden ses kullanmayın.
FRIDAY_VOICE_ID=
MEETING_MAX_ROUNDS=3
MEETING_MAX_TURNS=40
MEETING_MAX_TOKENS=60000
# Kullanıcı bu kadar susunca sözü bitti sayılır (tarayıcıda ?vad=500 ile de değiştirilebilir)
VAD_SILENCE_MS=700

# Ultron Paketi (README → "Ultron Paketi"). A: Savaş Modu (gösteri; sistemde hiçbir şey değişmez) · B: Ultron'un Gözü (gerçek veri)
# Ultron'un sesi: ElevenLabs ses kimliği. Özgün bir ses seçin; film oyuncusunu/dublaj sanatçısını taklit eden ya da klonlanmış ses kullanmayın.
# Boşsa hesaptaki derin bir Türkçe erkek sesi (Jarvis'inkinden farklı) seçilir.
ULTRON_VOICE_ID=
# Kayıt modunun varsayılan oranı: 9:16 veya 16:9
ULTRON_ASPECT=9:16
# İsteğe bağlı: anlatım cümleleri için model (boşsa Toplantı Odası'nın Jarvis modeli)
ULTRON_MODEL=

# A · Savaş Modu
SAVAS_MODU_ENABLED=true
# A = Ultron'un Gözü'ne geçiş, B = kapatma parolasıyla geri dönüş
ULTRON_FINAL=A
ULTRON_KILL_PHRASE=Protokol Friday
# Canlı varyasyon (Ultron'un repliklerinden 1–2'si o günkü kullanımdan): henüz yok, video çekimi için kapalı kalmalı
SAVAS_MODU_LIVE=false

# B · Ultron'un Gözü
ULTRON_EYE_ENABLED=true
# "Çevremde ne var?" için şehir (ör. Ankara). Konum yalnızca panelde izin verilirse ve o soruda kullanılır.
ULTRON_HOME_CITY=
# OpenSky (isteğe bağlı; anahtarsız da çalışır, kota düşük): opensky-network.org → Account → API Client
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=
# NASA FIRMS yangın verisi (ücretsiz MAP_KEY gerekli): firms.modaps.eosdis.nasa.gov → MAP KEY
NASA_FIRMS_MAP_KEY=
# abuse.ch URLhaus son zararlı URL sayısı (isteğe bağlı; Auth-Key gerekir)
URLHAUS_ENABLED=false
URLHAUS_AUTH_KEY=
